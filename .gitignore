# Byte-compiled / build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# CatBoost training artifacts (regenerated on every run; allow_writing_files
# is set False on the CatBoostModel wrapper, but sub-processes/notebooks may
# still create this)
catboost_info/

# OS junk
.DS_Store
Thumbs.db

# Virtual environments
venv/
.venv/
env/

# NOTE: data/processed/ and outputs/runs/ are intentionally NOT ignored -
# this repository tracks pipeline run outputs (tables, figures, reports,
# fold-level predictions) directly so results are reviewable in git history
# without re-running the pipeline.

# IDE
.vscode/
.idea/
